# Moniva — ortam değişkenleri şablonu
# Bu dosya GitHub'a girer (örnek/boş). Gerçek secret'lar .env / .env.local'de ve
# Vercel panelinde tutulur — buraya GERÇEK değer YAZMA.

# ── Veritabanı (zorunlu) ──────────────────────────────────────────
# Test/demo için bulut Postgres (Neon, Supabase vb.). Yerel: localhost:5432
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Auth.js v5 (zorunlu) ──────────────────────────────────────────
# AUTH_SECRET üret: `npx auth secret` veya `openssl rand -base64 32`
AUTH_SECRET="rastgele-uzun-bir-deger"
# Vercel/localhost dışı host'larda gerekli — test dağıtımında "true"
AUTH_TRUST_HOST="true"

# ── Cloudflare R2 — görsel/PDF depolama (zorunlu) ─────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# ── Site URL (SEO/canonical) ──────────────────────────────────────
# Test dağıtımında Vercel adresi, örn. https://moniva-xxx.vercel.app
NEXT_PUBLIC_SITE_URL="https://moniva-xxx.vercel.app"

# ── E-posta (opsiyonel — demo'da boş bırakılabilir) ───────────────
# Boşsa bildirim e-postaları gönderilmez, site çalışmaya devam eder.
RESEND_API_KEY=""
EMAIL_FROM="Moniva <bildirim@moniva.com.tr>"
